    {
      "id": "s6",
      "role": "under-the-hood",
      "title": "What is retried, and what is not",
      "narration": [
        {
          "text": "retryDecision retries a WeatherError only for 429 and 5xx. A 404 fails at once.",
          "evidence": ["S4", "F3.H2", "NOTES"]
        },
        {
          "text": "A TypeError means fetch got no response, so it is retried as a network error.",
          "evidence": ["S4", "F3.H2"]
        },
        {
          "text": "retryAfterMs reads Retry-After, in seconds or as a date. That wait replaces the backoff.",
          "evidence": ["S3", "F3.H2", "NOTES"]
        }
      ],
