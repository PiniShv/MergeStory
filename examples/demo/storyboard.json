    {
      "id": "s4",
      "role": "under-the-hood",
      "title": "The retry loop",
      "narration": [
        {
          "text": "withRetry fills in defaults from DEFAULT_RETRY, then runs the operation in a loop.",
          "evidence": ["S14", "S10", "F6.H1"]
        },
        {
          "text": "On a final error, or after the last allowed retry, it throws the error.",
          "evidence": ["S14", "F6.H1"]
        },
        {
          "text": "Otherwise it waits: afterMs if the decision has one, or else backoffDelay.",
          "evidence": ["S14", "F6.H1"]
        }
      ],
      "visual": {
        "type": "code",
        "ref": {
          "path": "src/retry.ts",
