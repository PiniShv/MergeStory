      "id": "s5",
      "role": "under-the-hood",
      "title": "The retry policy",
      "narration": [
        {
          "text": "The defaults: three retries, a 250 millisecond base delay and a four second cap.",
          "evidence": ["S10", "R3", "F6.H1"]
        },
        {
          "text": "isRetryableStatus accepts only 429 and 5xx.",
          "evidence": ["S12", "F6.H1"]
        },
        {
          "text": "backoffDelay picks a random wait below a limit that doubles each time. That is full jitter.",
          "evidence": ["S13", "F6.H1", "NOTES"]
        }
      ],
      "visual": {
        "type": "code",
