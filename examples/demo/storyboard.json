      "narration": [
        {
          "text": "When the API is busy, forecasts fail with 429, 503 or a network error. Callers retry by hand.",
          "evidence": ["TASK"]
        },
        {
          "text": "The task: retry those failures with exponential backoff, and respect Retry-After.",
          "evidence": ["TASK", "S6"]
        }
