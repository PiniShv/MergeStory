            "endLine": 38,
            "note": "Stop on a final error or the last retry",
            "beat": 1
          },
          {
            "startLine": 39,
            "endLine": 40,
            "note": "Wait: afterMs, else backoff",
            "beat": 2
          }
        ],
        "caption": null
